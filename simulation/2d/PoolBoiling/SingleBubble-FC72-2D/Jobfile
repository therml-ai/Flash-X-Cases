# YAML configuration file for `jobrunner`.
#
# flash.toml here is the base shared by every case. generate_cases.py writes
# one subdirectory per wall temperature holding only what differs, and
# flashInput.sh merges the two into the case's flash.par at submit. Build once
# here, then submit the generated cases:
#
#   python simulation/2d/PoolBoiling/SingleBubble-FC72-2D/generate_cases.py --wall_temp 80 90 100
#   jobrunner setup simulation/2d/PoolBoiling/SingleBubble-FC72-2D
#   jobrunner submit simulation/2d/PoolBoiling/SingleBubble-FC72-2D/case-twall-100

# Appended to the root Jobfile's options; --ntasks=36 comes after its
# --ntasks=10 and replaces it. 36 ranks divide the 108 blocks evenly (3
# each). Keep them on one node: Open MPI fails to launch its per-node daemons
# through srun when Slurm splits the job across nodes.
schedular:
  options:
    - "#SBATCH --ntasks=36"
    - "#SBATCH --nodes=1"

job:
  target: flashx
  setup:
    - flashOptions.sh
    - flashBuild.sh
  submit:
    - flashInput.sh
    - flashRun.sh
  input:
    - flash.toml
  archive:
    - flash.par
    - amrex.pc
  clean:
    - flashx
    - setup_params
    - flash.par
    - amrex.pc
    - "*_hdf5_htr_*"
